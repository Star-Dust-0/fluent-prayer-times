<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FluentPrayerTimes.WidgetWindow">
    <Window.Content>
        <Grid x:Name="Surface" Background="#00FFFFFF" Padding="10" PointerPressed="Surface_PointerPressed" PointerMoved="Surface_PointerMoved" PointerReleased="Surface_PointerReleased">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Children>
                <Grid Grid.Row="0" FlowDirection="LeftToRight" Margin="0,0,0,2" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.Children>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                            <StackPanel.Children>
                                <ToggleButton x:Name="BtnPin"
                                    Width="21.6"
                                    Height="19.2"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    ToolTipService.ToolTip="تثبيت فوق كل النوافذ" Click="Pin_Click">
                                    <ToggleButton.Content>
                                        <FontIcon Glyph="" FontSize="9.6" />
                                    </ToggleButton.Content>
                                </ToggleButton>
                                <Button x:Name="BtnHide"
                                    Width="21.6"
                                    Height="19.2"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    ToolTipService.ToolTip="إخفاء" Click="Close_Click">
                                    <Button.Content>
                                        <FontIcon Glyph="" FontSize="8.4" />
                                    </Button.Content>
                                </Button>
                            </StackPanel.Children>
                        </StackPanel>
                        <TextBlock x:Name="TxtHeader"
                            Grid.Column="1"
                            Text="الصلاة القادمة"
                            FontSize="11"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid.Children>
                </Grid>
                <StackPanel x:Name="PanelInfo" Grid.Row="1" Spacing="0">
                    <StackPanel.Children>
                        <StackPanel x:Name="PrayerRow" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" Margin="0,5,0,4">
                            <StackPanel.Children>
                                <TextBlock x:Name="TxtName" Text="--" FontSize="15.6" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtTime"
                                    Text=""
                                    FontSize="9.6"
                                    VerticalAlignment="Center"
                                    FlowDirection="LeftToRight"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel.Children>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                            <StackPanel.Children>
                                <TextBlock x:Name="TxtUnit"
                                    Text=""
                                    FontSize="12"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,6"
                                    Visibility="Collapsed"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TxtCount"
                                    Text="--:--"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    FlowDirection="LeftToRight"
                                    TextAlignment="Center"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel.Children>
                        </StackPanel>
                    </StackPanel.Children>
                </StackPanel>
            </Grid.Children>
        </Grid>
    </Window.Content>
</Window>