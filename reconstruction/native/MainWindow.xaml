<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FluentPrayerTimes.MainWindow">
    <Window.Content>
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Children>
                <Grid x:Name="TitleBarArea" Grid.Row="0">
                    <Grid.Children>
                        <StackPanel x:Name="TitleStack" Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel.Children>
                                <Image x:Name="ImgTitle" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Fluent Prayer Times" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel.Children>
                        </StackPanel>
                    </Grid.Children>
                </Grid>
                <NavigationView x:Name="Nav"
                    Grid.Row="1"
                    PaneDisplayMode="LeftCompact"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    OpenPaneLength="200"
                    IsPaneOpen="False" SelectionChanged="Nav_SelectionChanged">
                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="المواقيت" Tag="times">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="التقويم الهجري" Tag="calendar">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="محول التاريخ" Tag="convert">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="منبه الأذكار" Tag="azkar">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                    <NavigationView.FooterMenuItems>
                        <NavigationViewItem Content="الإعدادات" Tag="settings">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="عن البرنامج" Tag="about">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.FooterMenuItems>
                    <NavigationView.Content>
                        <Grid>
                            <Grid.Children>
                                <ScrollViewer x:Name="PageTimes" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                                    <ScrollViewer.Content>
                                        <StackPanel x:Name="PanelTimes" Spacing="10" Padding="0,8,0,14" HorizontalAlignment="Center">
                                            <StackPanel.Children>
                                                <StackPanel Spacing="2">
                                                    <StackPanel.Children>
                                                        <TextBlock Text="مواقيت الصلاة" FontSize="24" FontWeight="SemiBold" />
                                                        <TextBlock x:Name="TxtCity" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock x:Name="TxtDates" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel.Children>
                                                </StackPanel>
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16,12">
                                                    <Border.Child>
                                                        <StackPanel Spacing="2">
                                                            <StackPanel.Children>
                                                                <TextBlock x:Name="TxtNextLabel" Text="الصلاة القادمة" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <StackPanel Orientation="Horizontal" Spacing="14">
                                                                    <StackPanel.Children>
                                                                        <TextBlock x:Name="TxtNextName" Text="--" FontSize="26" FontWeight="SemiBold" />
                                                                        <TextBlock x:Name="TxtNextTime"
                                                                            Text=""
                                                                            FontSize="16"
                                                                            VerticalAlignment="Bottom"
                                                                            Margin="0,0,0,4"
                                                                            FlowDirection="LeftToRight"
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </StackPanel.Children>
                                                                </StackPanel>
                                                                <StackPanel
                                                                    Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    FlowDirection="LeftToRight"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="0,4,0,0">
                                                                    <StackPanel.Children>
                                                                        <TextBlock x:Name="TxtUnit"
                                                                            Text=""
                                                                            FontSize="18"
                                                                            VerticalAlignment="Bottom"
                                                                            Margin="0,0,0,6"
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                        <TextBlock x:Name="TxtCountdown"
                                                                            Text="--:--"
                                                                            FontSize="40"
                                                                            FontWeight="SemiBold"
                                                                            FlowDirection="LeftToRight"
                                                                            VerticalAlignment="Center"
                                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                                    </StackPanel.Children>
                                                                </StackPanel>
                                                                <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel.Children>
                                                        </StackPanel>
                                                    </Border.Child>
                                                </Border>
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,8">
                                                    <Border.Child>
                                                        <StackPanel Spacing="2">
                                                            <StackPanel.Children>
                                                                <TextBlock Text="مواقيت اليوم" FontSize="16" FontWeight="SemiBold" Margin="8,2,8,4" />
                                                                <StackPanel x:Name="RowsPanel" Spacing="2" />
                                                            </StackPanel.Children>
                                                        </StackPanel>
                                                    </Border.Child>
                                                </Border>
                                            </StackPanel.Children>
                                        </StackPanel>
                                    </ScrollViewer.Content>
                                </ScrollViewer>
                                <ScrollViewer x:Name="PageCalendar" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                                    <ScrollViewer.Content>
                                        <StackPanel x:Name="PanelCalendar" Padding="0,8,0,20" HorizontalAlignment="Center" />
                                    </ScrollViewer.Content>
                                </ScrollViewer>
                                <ScrollViewer x:Name="PageConvert" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                                    <ScrollViewer.Content>
                                        <StackPanel x:Name="PanelConvert" Padding="0,8,0,20" HorizontalAlignment="Center" />
                                    </ScrollViewer.Content>
                                </ScrollViewer>
                                <ScrollViewer x:Name="PageAzkar" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                                    <ScrollViewer.Content>
                                        <StackPanel x:Name="PanelAzkar" Padding="0,8,0,20" HorizontalAlignment="Center" />
                                    </ScrollViewer.Content>
                                </ScrollViewer>
                                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                                    <ScrollViewer.Content>
                                        <StackPanel x:Name="PanelSettings" Spacing="10" Padding="0,8,0,20" HorizontalAlignment="Center">
                                            <StackPanel.Children>
                                                <TextBlock Text="الإعدادات" FontSize="24" FontWeight="SemiBold" />
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16">
                                                    <Border.Child>
                                                        <StackPanel Spacing="10">
                                                            <StackPanel.Children>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.Children>
                                                                        <TextBlock Text="اللغة / Language" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        <Button x:Name="BtnApply" Grid.Column="1" Content="تطبيق التغييرات" Style="{StaticResource AccentButtonStyle}" / Click="ApplyChanges_Click">
                                                                    </Grid.Children>
                                                                </Grid>
                                                                <ComboBox x:Name="CmbLang" MinWidth="240" / SelectionChanged="Lang_Changed">
                                                                <TextBlock Text="المظهر" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                                                                <TextBlock Text="الخلفية" FontWeight="SemiBold" />
                                                                <StackPanel Orientation="Horizontal" Spacing="14">
                                                                    <StackPanel.Children>
                                                                        <RadioButton x:Name="RbMicaAlt" GroupName="bd" Content="Mica Alt" Tag="micaalt" MinWidth="0" / Checked="Backdrop_Checked">
                                                                        <RadioButton x:Name="RbMica" GroupName="bd" Content="Mica" Tag="mica" MinWidth="0" / Checked="Backdrop_Checked">
                                                                        <RadioButton x:Name="RbAcrylic" GroupName="bd" Content="Acrylic" Tag="acrylic" MinWidth="0" / Checked="Backdrop_Checked">
                                                                    </StackPanel.Children>
                                                                </StackPanel>
                                                                <TextBlock Text="السمة" FontWeight="SemiBold" Margin="0,6,0,0" />
                                                                <StackPanel Orientation="Horizontal" Spacing="14">
                                                                    <StackPanel.Children>
                                                                        <RadioButton x:Name="RbThemeSys" GroupName="th" Content="حسب النظام" Tag="system" MinWidth="0" / Checked="Theme_Checked">
                                                                        <RadioButton x:Name="RbThemeLight" GroupName="th" Content="فاتح" Tag="light" MinWidth="0" / Checked="Theme_Checked">
                                                                        <RadioButton x:Name="RbThemeDark" GroupName="th" Content="غامق" Tag="dark" MinWidth="0" / Checked="Theme_Checked">
                                                                    </StackPanel.Children>
                                                                </StackPanel>
                                                                <TextBlock Text="لون التطبيق" FontWeight="SemiBold" Margin="0,6,0,0" />
                                                                <Expander x:Name="ExpAccent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                                    <Expander.Header>
                                                                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,10">
                                                                            <StackPanel.Children>
                                                                                <Border x:Name="AccentSwatch"
                                                                                    Width="22"
                                                                                    Height="22"
                                                                                    CornerRadius="11"
                                                                                    BorderThickness="1"
                                                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                                                                <TextBlock Text="اختيار لون السمة" VerticalAlignment="Center" />
                                                                            </StackPanel.Children>
                                                                        </StackPanel>
                                                                    </Expander.Header>
                                                                    <Expander.Content>
                                                                        <StackPanel Spacing="14" FlowDirection="LeftToRight">
                                                                            <StackPanel.Children>
                                                                                <StackPanel x:Name="AccentPresets" Orientation="Horizontal" Spacing="8" />
                                                                                <StackPanel x:Name="AccentPresets2" Orientation="Horizontal" Spacing="8" />
                                                                                <Button x:Name="BtnAccentCustom" Content="لون مخصص…" / Click="AccentCustom_Click">
                                                                                <Button x:Name="BtnAccentReset" Content="استعادة اللون الافتراضي" / Click="AccentReset_Click">
                                                                            </StackPanel.Children>
                                                                        </StackPanel>
                                                                    </Expander.Content>
                                                                </Expander>
                                                                <TextBlock Text="يتأثر Mica وMica Alt بخلفية سطح المكتب، أما Acrylic فهو شفاف مع تمويه. يمكن أن تتبع السمة النظام أو تُحدَّد يدويًا." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel.Children>
                                                        </StackPanel>
                                                    </Border.Child>
                                                </Border>
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16">
                                                    <Border.Child>
                                                        <StackPanel Spacing="10">
                                                            <StackPanel.Children>
                                                                <TextBlock Text="الموقع" FontSize="16" FontWeight="SemiBold" />
                                                                <TextBlock Text="الدولة" FontWeight="SemiBold" />
                                                                <ComboBox x:Name="CmbCountry" HorizontalAlignment="Stretch" / SelectionChanged="Country_Changed">
                                                                <TextBlock Text="المدن" FontWeight="SemiBold" Margin="0,6,0,0" />
                                                                <ComboBox x:Name="CmbCity" HorizontalAlignment="Stretch" / SelectionChanged="City_Changed">
                                                                <TextBlock Text="البحث عن أي مدينة أو منطقة (في الدولة المختارة أو في كل العالم)" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.Children>
                                                                        <TextBox x:Name="TxtSearch" PlaceholderText="اسم المنطقة أو المدينة" / KeyDown="Search_KeyDown">
                                                                        <Button Grid.Column="1" Content="بحث" />
                                                                    </Grid.Children>
                                                                </Grid>
                                                                <ListView x:Name="LstPlaces" MaxHeight="200" Visibility="Collapsed" / SelectionChanged="Place_Selected">
                                                                <StackPanel Orientation="Vertical" Spacing="6" Margin="0,6,0,0">
                                                                    <StackPanel.Children>
                                                                        <Button Content="تحديد موقعي تلقائيًا" />
                                                                        <TextBlock x:Name="TxtDetect" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </StackPanel.Children>
                                                                </StackPanel>
                                                                <TextBlock Text="إحداثيات يدوية" FontWeight="SemiBold" Margin="0,6,0,0" />
                                                                <StackPanel Orientation="Horizontal" Spacing="8" FlowDirection="LeftToRight" HorizontalAlignment="Center">
                                                                    <StackPanel.Children>
                                                                        <TextBox x:Name="TxtLat" Width="110" PlaceholderText="Latitude" />
                                                                        <TextBox x:Name="TxtLon" Width="110" PlaceholderText="Longitude" />
                                                                        <Button Content="تطبيق" />
                                                                    </StackPanel.Children>
                                                                </StackPanel>
                                                            </StackPanel.Children>
                                                        </StackPanel>
                                                    </Border.Child>
                                                </Border>
                                                <Border x:Name="CalculationCard"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16">
                                                    <Border.Child>
                                                        <StackPanel Spacing="10">
                                                            <StackPanel.Children>
                                                                <TextBlock Text="طريقة حساب المواقيت" FontSize="16" FontWeight="SemiBold" />
                                                                <StackPanel x:Name="CalculationControls" Spacing="8" />
                                                                <TextBlock x:Name="DstTitle" Text="التوقيت الصيفي" FontWeight="SemiBold" />
                                                                <StackPanel x:Name="DstPanel" Orientation="Vertical" Spacing="2">
                                                                    <StackPanel.Children>
                                                                        <RadioButton x:Name="RbDstAuto" GroupName="dst" Content="تلقائي" Tag="auto" MinWidth="0" / Checked="Dst_Checked">
                                                                        <RadioButton x:Name="RbDstOff" GroupName="dst" Content="إيقاف (UTC+2)" Tag="off" MinWidth="0" / Checked="Dst_Checked">
                                                                        <RadioButton x:Name="RbDstOn" GroupName="dst" Content="تشغيل (UTC+3)" Tag="on" MinWidth="0" / Checked="Dst_Checked">
                                                                    </StackPanel.Children>
                                                                </StackPanel>
                                                            </StackPanel.Children>
                                                        </StackPanel>
                                                    </Border.Child>
                                                </Border>
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16">
                                                    <Border.Child>
                                                        <StackPanel Spacing="10">
                                                            <StackPanel.Children>
                                                                <TextBlock Text="ويدجت سطح المكتب" FontSize="16" FontWeight="SemiBold" />
                                                                <TextBlock Text="نافذة صغيرة عائمة تعرض الصلاة القادمة والعدّاد، يمكن تحريكها بالسحب وتثبيتها فوق النوافذ." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <ToggleSwitch x:Name="TglWidget" OnContent="ظاهر" OffContent="مخفي" / Toggled="Widget_Toggled">
                                                            </StackPanel.Children>
                                                        </StackPanel>
                                                    </Border.Child>
                                                </Border>
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16">
                                                    <Border.Child>
                                                        <StackPanel Spacing="10">
                                                            <StackPanel.Children>
                                                                <TextBlock Text="الإشعارات" FontSize="16" FontWeight="SemiBold" />
                                                                <TextBlock Text="إشعار عند دخول وقت كل صلاة: حان الآن موعد أذان ..." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <ToggleSwitch x:Name="TglAdhan" OnContent="مفعّل" OffContent="متوقف" / Toggled="Adhan_Toggled">
                                                                <StackPanel x:Name="PanelSounds" Spacing="10" />
                                                            </StackPanel.Children>
                                                        </StackPanel>
                                                    </Border.Child>
                                                </Border>
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16">
                                                    <Border.Child>
                                                        <StackPanel Spacing="10">
                                                            <StackPanel.Children>
                                                                <TextBlock Text="الإقامة" FontSize="16" FontWeight="SemiBold" />
                                                                <TextBlock Text="مدة الانتظار بين الأذان والإقامة لكل صلاة (بالدقائق)" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <StackPanel x:Name="PanelIqama" Spacing="8" />
                                                            </StackPanel.Children>
                                                        </StackPanel>
                                                    </Border.Child>
                                                </Border>
                                                <Border x:Name="UpdateSettingsCard"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="24">
                                                    <Border.Child>
                                                        <StackPanel Spacing="8">
                                                            <StackPanel.Children>
                                                                <TextBlock Text="التحديثات" FontSize="16" FontWeight="SemiBold" />
                                                                <ToggleSwitch x:Name="TglAutoUpdate" Header="البحث التلقائي عن التحديثات" OnContent="مفعّل" OffContent="متوقف" / Toggled="AutoUpdate_Toggled">
                                                                <TextBlock Text="يفحص البرنامج أحدث إصدار مستقر على GitHub في الخلفية عند التشغيل ثم كل ست ساعات، ويعرض إشعارًا فيه زر تحميل مباشر عند توفر إصدار أحدث." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock x:Name="TxtUpdateVersion" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <Button x:Name="BtnUpdate" Content="التحقق من التحديثات" HorizontalAlignment="Left" / Click="Update_Click">
                                                                <TextBlock x:Name="TxtUpdate" TextWrapping="Wrap" FontSize="13" />
                                                                <HyperlinkButton x:Name="UpdateLink" Content="فتح صفحة التنزيل" Visibility="Collapsed" HorizontalAlignment="Left" />
                                                                <Button x:Name="BtnUpdateInstall" Content="تنزيل وتثبيت" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" HorizontalAlignment="Left" / Click="UpdateInstall_Click">
                                                            </StackPanel.Children>
                                                        </StackPanel>
                                                    </Border.Child>
                                                </Border>
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16">
                                                    <Border.Child>
                                                        <StackPanel Spacing="10">
                                                            <StackPanel.Children>
                                                                <TextBlock Text="التشغيل" FontSize="16" FontWeight="SemiBold" />
                                                                <TextBlock Text="تشغيل البرنامج مع بدء ويندوز" FontWeight="SemiBold" />
                                                                <ToggleSwitch x:Name="TglStartup" OnContent="مفعّل" OffContent="متوقف" / Toggled="Startup_Toggled">
                                                            </StackPanel.Children>
                                                        </StackPanel>
                                                    </Border.Child>
                                                </Border>
                                            </StackPanel.Children>
                                        </StackPanel>
                                    </ScrollViewer.Content>
                                </ScrollViewer>
                                <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                                    <ScrollViewer.Content>
                                        <StackPanel x:Name="PanelAbout" Spacing="10" Padding="0,8,0,20" HorizontalAlignment="Center">
                                            <StackPanel.Children>
                                                <TextBlock Text="عن البرنامج" FontSize="24" FontWeight="SemiBold" />
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="20,28">
                                                    <Border.Child>
                                                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                            <StackPanel.Children>
                                                                <Image x:Name="ImgLogo" Width="88" Height="88" HorizontalAlignment="Center" />
                                                                <TextBlock
                                                                    Text="برنامج مواقيت الصلاة"
                                                                    FontSize="24"
                                                                    FontWeight="SemiBold"
                                                                    HorizontalAlignment="Center"
                                                                    TextAlignment="Center"
                                                                    Margin="0,6,0,0" />
                                                                <TextBlock x:Name="TxtVersion"
                                                                    Text=""
                                                                    FontSize="14"
                                                                    HorizontalAlignment="Center"
                                                                    TextAlignment="Center"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <HyperlinkButton
                                                                    Content="brought to you by Instinct"
                                                                    NavigateUri="https://instinct.com"
                                                                    FlowDirection="LeftToRight"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="0,4,0,0" />
                                                                <HyperlinkButton Content="GitHub Repo Link" NavigateUri="https://github.com/MohamedElnaggar00/fluent-prayer-times" FlowDirection="LeftToRight" HorizontalAlignment="Center" />
                                                            </StackPanel.Children>
                                                        </StackPanel>
                                                    </Border.Child>
                                                </Border>
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16">
                                                    <Border.Child>
                                                        <StackPanel Spacing="6">
                                                            <StackPanel.Children>
                                                                <TextBlock Text="مصادر البيانات" FontSize="16" FontWeight="SemiBold" />
                                                                <TextBlock Text="المطور: محمد النجار" FontSize="13" />
                                                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="تُحسب المواقيت داخل البرنامج بالثواني لطرق الحساب القائمة على الزوايا (الهيئة المصرية ورابطة العالم الإسلامي وكراتشي وأمريكا الشمالية والكويت والزوايا المخصصة)، وتُقرَّب الصلوات لأقرب دقيقة والشروق لأسفل. باقي الطرق، والأماكن القطبية التي لا تشرق فيها الشمس أو لا تغيب، والتاريخ الهجري والمنطقة الزمنية من Aladhan API. البحث عن الأماكن من Open-Meteo. تُخزَّن الإعدادات والمواقيت محليًا في AppData، فيعمل البرنامج دون اتصال بالإنترنت." />
                                                            </StackPanel.Children>
                                                        </StackPanel>
                                                    </Border.Child>
                                                </Border>
                                                <Border x:Name="UpdateAboutCard"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="24"
                                                    HorizontalAlignment="Stretch">
                                                    <Border.Child>
