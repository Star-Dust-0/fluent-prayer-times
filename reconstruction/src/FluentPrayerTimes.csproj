<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FluentPrayerTimes</AssemblyName>
    <Nullable>enable</Nullable>
    <OriginalAppDir Condition="'$(OriginalAppDir)' == ''">$(MSBuildThisFileDirectory)../../../../original/FluentPrayerTimes-SelfContained</OriginalAppDir>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <TargetFramework>netcoreapp8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup />
  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core.Projection">
      <HintPath>$(OriginalAppDir)/Microsoft.Web.WebView2.Core.Projection.dll</HintPath>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>$(OriginalAppDir)/WinRT.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="System.Runtime.InteropServices">
      <HintPath>$(OriginalAppDir)/System.Runtime.InteropServices.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.WinUI">
      <HintPath>$(OriginalAppDir)/Microsoft.WinUI.dll</HintPath>
    </Reference>
    <Reference Include="System.Threading">
      <HintPath>$(OriginalAppDir)/System.Threading.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>$(OriginalAppDir)/Microsoft.Windows.SDK.NET.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.InteractiveExperiences.Projection">
      <HintPath>$(OriginalAppDir)/Microsoft.InteractiveExperiences.Projection.dll</HintPath>
    </Reference>
    <Reference Include="System.Collections">
      <HintPath>$(OriginalAppDir)/System.Collections.dll</HintPath>
    </Reference>
    <Reference Include="System.Text.Json">
      <HintPath>$(OriginalAppDir)/System.Text.Json.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Win32.Registry">
      <HintPath>$(OriginalAppDir)/Microsoft.Win32.Registry.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http">
      <HintPath>$(OriginalAppDir)/System.Net.Http.dll</HintPath>
    </Reference>
    <Reference Include="System.Text.RegularExpressions">
      <HintPath>$(OriginalAppDir)/System.Text.RegularExpressions.dll</HintPath>
    </Reference>
    <Reference Include="System.Diagnostics.Process">
      <HintPath>$(OriginalAppDir)/System.Diagnostics.Process.dll</HintPath>
    </Reference>
    <Reference Include="System.Linq">
      <HintPath>$(OriginalAppDir)/System.Linq.dll</HintPath>
    </Reference>
    <Reference Include="System.Threading.Thread">
      <HintPath>$(OriginalAppDir)/System.Threading.Thread.dll</HintPath>
    </Reference>
    <Reference Include="System.Security.Cryptography">
      <HintPath>$(OriginalAppDir)/System.Security.Cryptography.dll</HintPath>
    </Reference>
    <Reference Include="System.Memory">
      <HintPath>$(OriginalAppDir)/System.Memory.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>